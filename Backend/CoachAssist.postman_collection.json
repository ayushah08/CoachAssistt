  "item": [
    {
      "name": "Main test sequence (run in order)",
      "item": [
        {
          "name": "01 Admin - login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP response is successful\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const d = pm.response.json(); if (d.token) pm.collectionVariables.set(\"adminToken\", d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Coaching - submit registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/coaching/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coachingName\": \"{{coachingName}}\",\n  \"email\": \"{{coachEmail}}\",\n  \"coachingAddress\": \"12 Main Road\",\n  \"coachingOwnerName\": \"Asha Rao\",\n  \"password\": \"{{coachPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tag = Date.now().toString() + Math.floor(Math.random() * 1000); pm.collectionVariables.set(\"coachEmail\", \"coach-\" + tag + \"@example.com\"); pm.collectionVariables.set(\"studentEmail\", \"student-\" + tag + \"@example.com\"); pm.collectionVariables.set(\"parentEmail\", \"parent-\" + tag + \"@example.com\");",
                  "pm.collectionVariables.set(\"coachingName\", \"North Star Academy \" + tag.slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP response is successful\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "const d = pm.response.json(); if (d.coachingId) pm.collectionVariables.set(\"coachingId\", d.coachingId);"
                ]
              }
            }
          ]
        },
        {
